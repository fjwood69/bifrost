#!/usr/bin/env python3
"""Unified Claude Code profile + model switcher. Replaces switch-claude-profile.sh + jr-model.

Usage:
  jr-model                 Interactive TUI
  jr-model status          Show profile + model only
  jr-model claude-jr       Switch profile (non-interactive)
  jr-model ds-v4-flash     Set model (non-interactive)
"""

from datetime import datetime
import json, os, sys, tty, termios, subprocess

# ── Colours (like the PS1) ──────────────────────────────────────────────────────
class C:
    CYAN    = "\033[36m"
    GREEN   = "\033[32m"
    YELLOW  = "\033[33m"
    RED     = "\033[31m"
    MAGENTA = "\033[35m"
    DARK    = "\033[90m"
    BLUE    = "\033[34m"
    BOLD    = "\033[1m"
    RESET   = "\033[0m"

def c(colour, text):
    return f"{colour}{text}{C.RESET}"

HOME          = os.path.expanduser("~")
CLAUDE_DIR    = f"{HOME}/.claude"
CLAUDE_JSON   = f"{HOME}/.claude.json"
LIVE_SETTINGS = f"{CLAUDE_DIR}/settings.json"
PROFILES_ROOT = f"{HOME}/.claude-profiles"

# Isolated config dirs for non-sub profiles (prevents OAuth contamination)
CONFIG_DIRS = {
    "claude-api": f"{HOME}/.claude-api",
    "claude-jr":  f"{HOME}/.claude-jr",
}
ACTIVE_FILE   = f"{PROFILES_ROOT}/.active"
JR_SETTINGS   = f"{PROFILES_ROOT}/claude-jr/settings.json"
VSCODE_BASE   = f"{HOME}/.config/Code/User/profiles"
BIFROST_API   = ("localhost", 8787)

# ── Passthrough VK mapping (device key suffix → Bifrost VK name) ────────────
PASSTHROUGH_VKS = {
    "4ceCOQAA": "claude-sr-passthrough",    # Twiggy
    "m4QAA":    "claude-sr-passthrough02",   # CB14P
    "nc9GAAA":  "claude-sr-passthrough03",   # UX3405
}

# ── Model table (single entries — Bifrost handles multi-route) ────────────
MODELS = [
    ("ds-v4-flash", "Novita/deepseek/deepseek-v4-flash",            "DeepSeek V4 Flash",  ""),
    ("ds-v4-pro",   "Novita/deepseek/deepseek-v4-pro",              "DeepSeek V4 Pro",    ""),
    ("ds-v3.2",     "nebius/deepseek-ai/DeepSeek-V3.2",             "DeepSeek V3.2",      ""),
    ("kimi",        "Moonshot/kimi-k2.6",                           "Kimi K2.6",          ""),
    ("glm51",       "Novita/zai-org/glm-5.1",                       "GLM 5.1",            ""),
    ("gemma4-26b",      "parasail/google/gemma-4-26B-A4B-it",           "Gemma 4 26B A4B it", ""),
    ("gemma4-31b",      "parasail/google/gemma-4-31B-it",           "Gemma 4 31B it", ""),
    ("gemini",      "gemini/gemini-3.5-flash",                         "Gemini 3.5 Flash",   "1M ctx"),
    ("mimo-pro",    "Deepinfra/XiaomiMiMo/MiMo-V2.5-Pro",             "MiMo V2.5 Pro",       ""),
    ("mimo",        "Deepinfra/XiaomiMiMo/MiMo-V2.5",                 "MiMo V2.5",           ""),
    ("nemotron",    "nebius/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B", "Nemotron 3 Nano",    ""),
]

# ── Helpers ───────────────────────────────────────────────────────────────────

def json_field(path, field):
    if not os.path.exists(path): return None
    try:
        with open(path) as f: return json.load(f).get(field)
    except: return None

def nested_env_field(path, field):
    if not os.path.exists(path): return None
    try:
        with open(path) as f: return json.load(f).get("env", {}).get(field)
    except: return None

def current_profile():
    if os.path.exists(ACTIVE_FILE):
        with open(ACTIVE_FILE) as f: return f.read().strip()
    return None

def current_model_id():
    # Read from the profile settings file (where we write), fall back to live
    if os.path.exists(JR_SETTINGS):
        path = JR_SETTINGS
    else:
        path = LIVE_SETTINGS
    val = nested_env_field(path, "ANTHROPIC_CUSTOM_MODEL_OPTION")
    if not val: val = json_field(path, "ANTHROPIC_CUSTOM_MODEL_OPTION")
    if not val: val = json_field(path, "model")
    return val

def model_info(model_id):
    if not model_id: return None
    for k, mid, name, notes in MODELS:
        if mid == model_id: return (k, mid, name, notes)
    for k, mid, name, notes in MODELS:
        if k == model_id: return (k, mid, name, notes)
    return None

def key_suffix(key):
    if not key or len(key) < 10: return None
    return key[-7:]

# ── Terminal ──────────────────────────────────────────────────────────────────

def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

def input_line(prompt=""):
    sys.stdout.write(prompt)
    sys.stdout.flush()
    try:
        return input().strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return ""

# ── Display ───────────────────────────────────────────────────────────────────

def show_status():
    cur = current_profile()
    mid = current_model_id()
    info = model_info(mid)

    print(c(C.CYAN, "=== Claude Code Status ==="))
    if cur:
        print(f"  Profile: {c(C.GREEN, cur)}")
        if mid:
            if info:
                print(f"  Model:   {c(C.CYAN, info[2])}")
            else:
                print(f"  Model:   {c(C.YELLOW, mid)}")

            if mid and "||" in mid:
                parts = mid.split("||")
                plan = parts[0].replace("plan:", "") if "plan:" in parts[0] else ""
                act = parts[1].replace("act:", "") if len(parts) > 1 and "act:" in parts[1] else ""
                print(f"  Mode:    {c(C.MAGENTA, 'Plan/Act')}")
                print(f"    PLAN: {c(C.BLUE, plan)}")
                print(f"    ACT:  {c(C.MAGENTA, act)}")
            else:
                print(f"  Mode:    {c(C.DARK, 'Single model')}")

        live_key = json_field(CLAUDE_JSON, "primaryApiKey")
        if live_key:
            suffix = key_suffix(live_key)
            print(f"  Key:     {c(C.DARK, '...' + suffix)}")
    else:
        print(f"  {c(C.YELLOW, 'No active profile set.')}")
    print(c(C.CYAN, "=" * 33))

def show_status_banner():
    cur = current_profile()
    mid = current_model_id()
    info = model_info(mid)
    mode_str = c(C.MAGENTA, " [Plan/Act]") if mid and "||" in mid else ""
    profile_str = c(C.GREEN, cur) if cur else c(C.YELLOW, "none")
    model_str = c(C.CYAN, info[2]) + mode_str if info else (c(C.YELLOW, mid) + mode_str if mid else c(C.DARK, "(not set)"))
    print(f"  Profile: {profile_str}")
    print(f"  Model:   {model_str}")
    print()

# ── Profile Switching ──────────────────────────────────────────────────────────

def find_vscode_profile():
    """Find the VS Code profile settings.json that's actually in use.
    fatrace confirms VS Code reads from profiles/*/settings.json, not
    the default ~/.config/Code/User/settings.json."""
    if not os.path.isdir(VSCODE_BASE): return None
    for name in os.listdir(VSCODE_BASE):
        candidate = os.path.join(VSCODE_BASE, name, "settings.json")
        if os.path.exists(candidate):
            try:
                if "claudeCode" in open(candidate).read():
                    return candidate
            except: pass
    return None

VSCODE_PROFILE = find_vscode_profile()

def update_vscode_profile(env_block):
    if not VSCODE_PROFILE or not os.path.exists(VSCODE_PROFILE): return
    try:
        vs = json.load(open(VSCODE_PROFILE))
        vs["claudeCode.environmentVariables"] = [{"name": k, "value": v} for k, v in env_block.items()]
        json.dump(vs, open(VSCODE_PROFILE, "w"), indent=4)
    except Exception as e:
        print(f"  Warning: VS Code profile update failed: {e}")

def add_vscode_env_var(name, value):
    if not VSCODE_PROFILE or not os.path.exists(VSCODE_PROFILE): return
    try:
        vs = json.load(open(VSCODE_PROFILE))
        env_vars = vs.get("claudeCode.environmentVariables", [])
        found = False
        for v in env_vars:
            if v["name"] == name:
                v["value"] = value
                found = True
                break
        if not found:
            env_vars.append({"name": name, "value": value})
        vs["claudeCode.environmentVariables"] = env_vars
        json.dump(vs, open(VSCODE_PROFILE, "w"), indent=4)
    except Exception as e:
        print(f"  Warning: VS Code env var update failed: {e}")

def switch_profile(target):
    target_dir = f"{PROFILES_ROOT}/{target}"
    src_settings   = f"{target_dir}/settings.json"
    src_claude_json = f"{target_dir}/claude.json"
    src_creds      = f"{target_dir}/credentials.json"

    if not os.path.exists(src_settings):
        print(f"ERROR: Profile '{target}' not found at {target_dir}")
        sys.exit(1)

    # If leaving claude-sub, save OAuth tokens back
    current = current_profile()
    if current == "claude-sub":
        live_creds = f"{CLAUDE_DIR}/.credentials.json"
        if os.path.exists(live_creds):
            subprocess.run(["cp", live_creds, f"{PROFILES_ROOT}/claude-sub/credentials.json"])
        subprocess.run(["cp", f"{HOME}/.claude.json", f"{PROFILES_ROOT}/claude-sub/claude.json"])

    # Resolve config dir early — needed for file copy destinations
    config_dir = CONFIG_DIRS.get(target, CLAUDE_DIR)
    os.makedirs(config_dir, exist_ok=True)

    print(c(C.CYAN, f"  -> Copying {target} profile..."))
    # Settings go to the isolated config dir (CLAUDE_CONFIG_DIR), not always ~/.claude/
    subprocess.run(["cp", src_settings, f"{config_dir}/settings.json"])
    if os.path.exists(src_claude_json):
        subprocess.run(["cp", src_claude_json, CLAUDE_JSON])
        # Also merge primaryApiKey into the isolated .claude.json so the CC extension
        # finds auth when CLAUDE_CONFIG_DIR redirects away from ~/.claude.json
        if config_dir != CLAUDE_DIR:
            isolated_dot_claude = f"{config_dir}/.claude.json"
            try:
                primary_key = json.load(open(src_claude_json)).get("primaryApiKey")
                if primary_key:
                    existing = {}
                    if os.path.exists(isolated_dot_claude):
                        try:
                            existing = json.load(open(isolated_dot_claude))
                        except Exception:
                            pass
                    existing["primaryApiKey"] = primary_key
                    with open(isolated_dot_claude, "w") as f:
                        json.dump(existing, f, indent=2)
            except Exception as e:
                print(f"  Warning: could not update isolated .claude.json: {e}")
    if os.path.exists(src_creds):
        # Credentials go to the isolated config dir — never overwrite ~/.claude/.credentials.json
        # (that holds the claude-sub OAuth tokens we saved above)
        subprocess.run(["cp", src_creds, f"{config_dir}/.credentials.json"])
        os.chmod(f"{config_dir}/.credentials.json", 0o600)

    with open(ACTIVE_FILE, "w") as f:
        f.write(target)

    # Update VS Code env vars
    try:
        target_settings = json.load(open(src_settings))
        env_block = dict(target_settings.get("env", {}))

        # Inject CLAUDE_CONFIG_DIR for isolated profiles (prevents OAuth contamination)
        if config_dir != CLAUDE_DIR:
            env_block["CLAUDE_CONFIG_DIR"] = config_dir

        # Null out vars that leak from inherited shell env when switching away
        # from claude-jr. Empty strings tell VS Code to override the inherited value.
        if target != "claude-jr":
            env_block.setdefault("ANTHROPIC_BASE_URL", "")
            env_block.setdefault("ANTHROPIC_AUTH_TOKEN", "")

        disable_prompt = target != "claude-sub"
        if VSCODE_PROFILE and os.path.exists(VSCODE_PROFILE):
            update_vscode_profile(env_block)
            vs = json.load(open(VSCODE_PROFILE))
            vs["claudeCode.disableLoginPrompt"] = disable_prompt
            json.dump(vs, open(VSCODE_PROFILE, "w"), indent=4)
    except Exception as e:
        print(f"  Warning: profile env setup failed: {e}")

    print(c(C.GREEN, f"  [OK] Switched to {target}"))

# ── Cross-Profile Drift Detection ──────────────────────────────────────────────

def check_drift():
    live_key = json_field(CLAUDE_JSON, "primaryApiKey")
    if not live_key: return

    # Check claude-sub OAuth tokens
    sub_dir = f"{PROFILES_ROOT}/claude-sub"
    if os.path.exists(sub_dir):
        live_sub_content = None
        sub_content = None
        live_creds = f"{CLAUDE_DIR}/.credentials.json"
        sub_creds = f"{sub_dir}/credentials.json"
        try:
            with open(live_creds) as f: live_sub_content = f.read()
        except: pass
        try:
            with open(sub_creds) as f: sub_content = f.read()
        except: pass
        if live_sub_content and live_sub_content != sub_content and live_sub_content != "{}":
            subprocess.run(["cp", CLAUDE_JSON, f"{sub_dir}/claude.json"])
            if live_sub_content:
                subprocess.run(["cp", live_creds, sub_creds])
            print("  -> claude-sub: OAuth tokens refreshed in golden config")

    # Check claude-api key
    api_dir = f"{PROFILES_ROOT}/claude-api"
    if os.path.exists(api_dir):
        api_golden = json_field(f"{api_dir}/claude.json", "primaryApiKey")
        if live_key and api_golden and live_key != api_golden:
            subprocess.run(["cp", CLAUDE_JSON, f"{api_dir}/claude.json"])
            print("  -> claude-api: key updated in golden config")

    # Check claude-jr passthrough key
    jr_dir = f"{PROFILES_ROOT}/claude-jr"
    if os.path.exists(jr_dir):
        jr_golden = json_field(f"{jr_dir}/claude.json", "primaryApiKey")
        if live_key and jr_golden and live_key != jr_golden:
            subprocess.run(["cp", CLAUDE_JSON, f"{jr_dir}/claude.json"])
            print("  -> claude-jr: key updated in golden config")

def update_bifrost_passthrough_vk(vk_name, new_key):
    print(f"  [!!] Real API key changed (passthrough VK: {vk_name})")
    resp = input_line("       SSH to NUC and update?\n       [y/N]: ")
    if resp.lower() != "y":
        print("  -> Skipped Bifrost VK update. Passthrough auth may fail.")
        return

    print("  -> Updating Bifrost VK on NUC...")
    escaped_key = new_key.replace("'", "''")
    db_cmd = f"podman exec bifrost sqlite3 /app/data/config.db \"UPDATE governance_virtual_keys SET value='{escaped_key}' WHERE name='{vk_name}'\""
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
         "-i", os.path.expanduser("~/.ssh/id_ed25519_mcp"),
         "nucadmin@100.84.128.79", db_cmd],
        capture_output=True, text=True, timeout=15
    )
    if result.returncode == 0:
        print("  [OK] Bifrost VK updated")
        restart = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
             "-i", os.path.expanduser("~/.ssh/id_ed25519_mcp"),
             "nucadmin@100.84.128.79", "podman restart bifrost"],
            capture_output=True, text=True, timeout=30
        )
        if restart.returncode == 0:
            print("  [OK] Bifrost restarted")
        else:
            print(f"  [!!] Bifrost restart failed: {restart.stderr.strip()}")
    else:
        print(f"  [!!] SSH failed: {result.stderr.strip()}")
        print("       Golden config saved locally. Update Bifrost VK manually.")

# ── Bifrost VK Update (via admin API — live-reloads in-memory store, no restart) ──

def _bifrost_update_vk_descriptions(model_value):
    import http.client as _http

    secrets = {}
    try:
        with open(os.path.expanduser("~/.claude/.secrets")) as f:
            for line in f:
                k, _, v = line.strip().partition("=")
                if k:
                    secrets[k] = v
    except Exception as e:
        print(f"  Warning: cannot read .secrets for Bifrost auth: {e}")
        return False

    user = secrets.get("BIFROST_ADMIN_USER")
    pw   = secrets.get("BIFROST_ADMIN_PASSWORD")
    if not user or not pw:
        print("  Warning: BIFROST_ADMIN_USER/PASSWORD not in .secrets")
        return False

    try:
        conn = _http.HTTPConnection(*BIFROST_API, timeout=10)

        # Login → session cookie
        body = json.dumps({"username": user, "password": pw}).encode()
        conn.request("POST", "/api/session/login", body, {"Content-Type": "application/json"})
        resp = conn.getresponse(); resp.read()
        if resp.status != 200:
            print(f"  Warning: Bifrost login failed (HTTP {resp.status})")
            return False
        cookie = next((v.split(";")[0] for h, v in resp.getheaders() if h.lower() == "set-cookie"), None)
        if not cookie:
            print("  Warning: Bifrost login returned no session cookie")
            return False

        headers = {"Cookie": cookie}

        # Fetch VK list → find claude-jr and claude-jr-passthrough IDs
        conn.request("GET", "/api/governance/virtual-keys", headers=headers)
        resp = conn.getresponse()
        data = json.loads(resp.read())
        if resp.status != 200:
            print(f"  Warning: Bifrost VK list failed (HTTP {resp.status})")
            return False
        target_names = {"claude-jr", "claude-jr-passthrough"}
        targets = {vk["id"]: vk["name"] for vk in data.get("virtual_keys", []) if vk.get("name") in target_names}
        if not targets:
            print("  Warning: claude-jr VKs not found in Bifrost — check VK names")
            return False

        # PUT description on each VK — Bifrost calls ReloadVirtualKey internally
        desc = json.dumps({"model_override": model_value})
        put_body = json.dumps({"description": desc}).encode()
        put_headers = {**headers, "Content-Type": "application/json"}
        ok = 0
        for vk_id, vk_name in targets.items():
            conn.request("PUT", f"/api/governance/virtual-keys/{vk_id}", put_body, put_headers)
            resp = conn.getresponse(); resp.read()
            if resp.status == 200:
                ok += 1
            else:
                print(f"  Warning: VK update failed for {vk_name} (HTTP {resp.status})")

        conn.close()
        return ok == len(targets)

    except Exception as e:
        print(f"  Warning: Bifrost VK update error: {e}")
        return False

# ── Model Switching ────────────────────────────────────────────────────────────

def set_model(model_value, model_key=None):
    # Always write to the profile settings file
    target_file = JR_SETTINGS
    if not os.path.exists(JR_SETTINGS):
        # Fall back to live if no profile dir yet (unusual)
        target_file = LIVE_SETTINGS

    if not os.path.exists(target_file):
        print(f"ERROR: {target_file} not found")
        return

    with open(target_file) as f: settings = json.load(f)
    settings["model"] = model_value
    settings.setdefault("env", {})
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION"] = model_value

    if "||" not in model_value and model_key:
        info = model_info(model_value)
        if not info: info = model_info(model_key)
        if info:
            settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION_NAME"] = info[2]

    settings["availableModels"] = [mid for _, mid, _, _ in MODELS]
    settings["_model_set_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(target_file, "w") as f:
        json.dump(settings, f, indent=2)

    # Propagate to live config (CLAUDE_CONFIG_DIR) so CC sidebar shows correct model
    active = current_profile()
    if active:
        live_dir = CONFIG_DIRS.get(active, CLAUDE_DIR)
        live_settings = f"{live_dir}/settings.json"
        if active == "claude-jr":
            with open(live_settings, "w") as f:
                json.dump(settings, f, indent=2)

    # Update VS Code env var
    if VSCODE_PROFILE:
        add_vscode_env_var("ANTHROPIC_CUSTOM_MODEL_OPTION", model_value)

    # Update Bifrost VK model_override via admin API (live-reloads in-memory store, no restart)
    if active == "claude-jr":
        ok = _bifrost_update_vk_descriptions(model_value)
        if not ok:
            print("  Warning: Bifrost VK update incomplete — model routing may be stale")

    print("  [OK] Model set")

# ── Interactive Menus ──────────────────────────────────────────────────────────

def profile_menu():
    print(c(C.CYAN, "--- Select Profile ---"))
    print(f"  1  {c(C.MAGENTA, 'claude-jr')}     (Bifrost - third-party models)")
    print("  2  claude-sub    (Claude Pro / OAuth)")
    print("  3  claude-api    (Direct Anthropic API)")
    print(f"  4  {c(C.DARK, 'stay on current')} (enter model picker)")
    print(f"  0  {c(C.DARK, 'exit')}")
    print()

    ch = input_line("Select: ")
    return {"1": "claude-jr", "2": "claude-sub", "3": "claude-api",
            "4": "stay", "0": "exit"}.get(ch, "retry")

def model_menu():
    current_id = current_model_id()
    current_info = model_info(current_id)
    current_name = current_info[2] if current_info else (current_id or "(not set)")

    print(c(C.CYAN, "--- Model Selection (claude-jr) ---"))
    print(f"  Current: {c(C.GREEN, current_name)}")
    print()
    print("  1  Single model")
    print(f"  2  {c(C.MAGENTA, 'Plan/Act pair')}")
    print(f"  0  {c(C.DARK, 'Keep current / exit')}")
    print()

    mode = input_line("Select mode: ")
    if mode == "1":
        model_key = model_picker("Select model")
        if model_key in (None, "back"):
            return False
        info = None
        for k, mid, name, notes in MODELS:
            if k == model_key: info = (k, mid, name, notes); break
        if info:
            print(f"Switching to {info[2]}...")
            set_model(info[1], info[0])
            print("Done.")
            print("Reload VS Code window (Ctrl+Shift+P -> Reload Window)")
            return True
    elif mode == "2":
        return plan_act_flow()
    return False

def model_picker(title):
    print(c(C.CYAN, f"--- {title} ---"))
    for i, (_, _, name, notes) in enumerate(MODELS, 1):
        note_str = c(C.DARK, f"  - {notes}") if notes else ""
        print(f"  {i}  {name}{note_str}")
    print(f"  0  {c(C.DARK, 'Cancel')}")
    print()

    ch = input_line("Select model: ")
    if ch == "0": return None
    try:
        idx = int(ch) - 1
        if 0 <= idx < len(MODELS):
            return MODELS[idx][0]
    except ValueError:
        pass
    print("Invalid choice.")
    return model_picker(title)

def plan_act_flow():
    print(c(C.CYAN, "--- Plan/Act Mode ---"))
    print(f"  {c(C.BLUE, 'First, pick the PLAN model (strong reasoning)')}")

    plan_key = model_picker("Select PLAN model")
    if plan_key in (None, "back"): return False

    plan_info = None
    for k, mid, name, notes in MODELS:
        if k == plan_key: plan_info = (k, mid, name, notes); break

    print(f"  {c(C.MAGENTA, 'Now pick the ACT model (fast executor)')}")

    act_key = model_picker("Select ACT model")
    if act_key in (None, "back"): return False

    act_info = None
    for k, mid, name, notes in MODELS:
        if k == act_key: act_info = (k, mid, name, notes); break

    if not plan_info or not act_info:
        print(c(C.RED, "Error: model not found"))
        return False

    compound = f"plan:{plan_info[1]}||act:{act_info[1]}"

    print()
    print(c(C.CYAN, "Plan/Act pair:"))
    print(f"  {c(C.BLUE, 'PLAN:')} {plan_info[2]}")
    print(f"  {c(C.MAGENTA, 'ACT:')}  {act_info[2]}")

    confirm = input_line("Apply? [Y/n]: ")
    if confirm.lower() == "n":
        print(c(C.YELLOW, "Cancelled."))
        return False

    set_model(compound)
    print(c(C.MAGENTA, "Done."))
    print(c(C.MAGENTA, "Reload VS Code window (Ctrl+Shift+P -> Reload Window)"))
    return True

# ── Non-Interactive Dispatch ────────────────────────────────────────────────────

def handle_noninteractive(arg):
    profiles = ["claude-jr", "claude-sub", "claude-api"]
    if arg in profiles:
        current = current_profile()
        if current == arg:
            print(f"Already on '{arg}' profile.")
            return
        switch_profile(arg)
        check_drift()
        print()
        print("Reload VS Code window (Ctrl+Shift+P -> Reload Window)")
        return

    for k, mid, _, _ in MODELS:
        if k == arg:
            set_model(mid, k)
            print()
            print("Reload VS Code window (Ctrl+Shift+P -> Reload Window)")
            return

    print(f"Unknown action: {arg}")
    print("Usage: jr-model [claude-jr|claude-api|claude-sub|status|<model-key>]")
    sys.exit(1)

# ── Main ───────────────────────────────────────────────────────────────────────

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""

    os.system("clear")
    print(c(C.CYAN, "=== Claude Code Switcher ==="))
    print()
    show_status_banner()

    if arg:
        if arg == "status":
            show_status()
            return
        handle_noninteractive(arg)
        return

    while True:
        choice = profile_menu()
        do_model_menu = False

        if choice == "exit":
            print("Bye!")
            return
        elif choice == "retry":
            continue
        elif choice == "stay":
            print("Staying on current profile.")
            check_drift()
            do_model_menu = True
        else:
            current = current_profile()
            if current != choice:
                switch_profile(choice)
            else:
                print(f"Already on '{choice}'.")
            check_drift()
            do_model_menu = (choice == "claude-jr")
            if not do_model_menu:
                print()
                print("Reload VS Code window (Ctrl+Shift+P -> Reload Window)")

        if do_model_menu:
            applied = model_menu()
            if not applied:
                print("No changes made.")

        break

if __name__ == "__main__":
    main()
