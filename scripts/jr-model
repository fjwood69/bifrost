#!/usr/bin/env python3
"""Switch the active custom model for the claude-jr Bifrost backend."""

import json
import sys
import os
import tty
import termios

PROFILE = os.path.expanduser("~/.claude-profiles/claude-jr/settings.json")
ACTIVE  = os.path.expanduser("~/.claude-profiles/.active")

MODELS = [
    # Plan/Act compound
    ("plan-act",      "plan:Deepinfra/moonshotai/Kimi-K2.6||act:nebius/deepseek-ai/DeepSeek-V3.2",
                                                                           "Plan: Kimi / Act: DeepSeek",         "Plan phase → Kimi K2.6 (DeepInfra); Act phase → DeepSeek V3.2 (Nebius)"),
    # DeepSeek V3.2
    ("deepseek-di",   "Deepinfra/deepseek-ai/DeepSeek-V3.2",              "DeepSeek V3.2 (DeepInfra)",          "Strong coder via Bifrost → DeepInfra"),
    ("deepseek-n",    "nebius/deepseek-ai/DeepSeek-V3.2",                  "DeepSeek V3.2 (Nebius)",             "Strong coder via Bifrost → Nebius"),
    ("deepseek",      "parasail/deepseek-ai/DeepSeek-V3.2",                "DeepSeek V3.2 (Parasail)",           "Strong coder via Bifrost → Parasail"),
    ("deepseek-v",    "vertex/deepseek-ai/deepseek-v3.2-maas",             "DeepSeek V3.2 (Vertex MaaS)",        "Strong coder via Bifrost → Vertex AI"),
    # Gemini
    ("gemini",        "gemini/gemini-3-flash-preview",                     "Gemini 3 Flash (Google)",            "1M ctx via Bifrost → Google"),
    # Gemma
    ("gemma26b",      "parasail/google/gemma-4-26B-A4B-it",                "Gemma 4 26B A4B (Parasail)",         "Google MoE via Bifrost → Parasail"),
    ("gemma26b-v",    "vertex/google/gemma-4-26b-a4b-it-maas",             "Gemma 4 26B A4B (Vertex MaaS)",      "Google MoE via Bifrost → Vertex AI"),
    # GLM
    ("glm5",          "vertex/zai-org/glm-5-maas",                         "GLM-5 (Vertex MaaS)",                "Zhipu GLM-5 via Bifrost → Vertex AI"),
    # Kimi
    ("kimi-di",       "Deepinfra/moonshotai/Kimi-K2.6",                    "Kimi K2.6 (DeepInfra)",              "Agentic MoE via Bifrost → DeepInfra"),
    ("kimi",          "parasail/moonshotai/Kimi-K2.6",                     "Kimi K2.6 (Parasail)",               "Agentic MoE via Bifrost → Parasail"),
    # MiniMax
    ("minimax",       "nebius/MiniMaxAI/MiniMax-M2.5",                     "MiniMax M2.5 (Nebius)",              "MiniMax via Bifrost → Nebius"),
    # Qwen
    ("qwen3-next",    "nebius/Qwen/Qwen3-Next-80B-A3B-Thinking",           "Qwen3-Next-80B Thinking (Nebius)",   "Thinking MoE via Bifrost → Nebius"),
    ("qwen35",        "parasail/Qwen/Qwen3.5-35B-A3B-FP8",                 "Qwen3.5-35B FP8 (Parasail)",         "Fast MoE via Bifrost → Parasail"),
]

def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

def find_vscode_profile():
    """Return VS Code profile settings.json path, or None."""
    cfg = os.path.expanduser("~/.claude-profiles/.vscode-profile-path")
    if os.path.exists(cfg):
        return open(cfg).read().strip()
    base = os.path.expanduser("~/.config/Code/User/profiles")
    if not os.path.isdir(base):
        return None
    for name in os.listdir(base):
        candidate = os.path.join(base, name, "settings.json")
        if os.path.exists(candidate):
            try:
                if "claudeCode" in open(candidate).read():
                    return candidate
            except OSError:
                pass
    return None

VSCODE_PROFILE = find_vscode_profile()

def update_vscode_profile(env: dict):
    if not VSCODE_PROFILE:
        return
    try:
        vs = json.load(open(VSCODE_PROFILE))
        vs["claudeCode.environmentVariables"] = [{"name": k, "value": v} for k, v in env.items()]
        json.dump(vs, open(VSCODE_PROFILE, "w"), indent=4)
    except Exception as e:
        print(f"  Warning: could not update VS Code profile: {e}")

def apply(model_id, name, desc, settings):
    settings.setdefault("env", {})
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION"]             = model_id
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION_NAME"]        = name
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION"] = desc
    settings["model"]                                             = model_id
    settings["availableModels"]                                   = [mid for _, mid, _, _ in MODELS]

    with open(PROFILE, "w") as f:
        json.dump(settings, f, indent=2)

    active = open(ACTIVE).read().strip() if os.path.exists(ACTIVE) else ""
    if active == "claude-jr":
        live = os.path.expanduser("~/.claude/settings.json")
        with open(live, "w") as f:
            json.dump(settings, f, indent=2)
        update_vscode_profile(settings["env"])

def main():
    with open(PROFILE) as f:
        settings = json.load(f)

    current_id = settings.get("env", {}).get("ANTHROPIC_CUSTOM_MODEL_OPTION", "")
    current_name = next((n for _, mid, n, _ in MODELS if mid == current_id), current_id)

    alternatives = [(k, mid, name, desc) for k, mid, name, desc in MODELS if mid != current_id]

    print(f"\n  claude-jr model")
    print(f"  ───────────────")
    print(f"  Current: {current_name}\n")

    for i, (_, _, name, desc) in enumerate(alternatives, 1):
        print(f"  {i:>2}  {name}")
        print(f"      {desc}")
    print(f"\n   0  Keep current and exit\n")

    if len(alternatives) > 9:
        print("  Select: ", end="", flush=True)
        try:
            ch = input().strip()
        except (EOFError, KeyboardInterrupt):
            print("\n  No change.\n")
            return
    else:
        print("  Select: ", end="", flush=True)
        ch = getch()
        print(ch)

    if ch == "0" or ch in ("\x03", "\x1b", "q", ""):
        print("  No change.\n")
        return

    try:
        idx = int(ch) - 1
        if 0 <= idx < len(alternatives):
            _, model_id, name, desc = alternatives[idx]
            apply(model_id, name, desc, settings)
            active = open(ACTIVE).read().strip() if os.path.exists(ACTIVE) else ""
            print(f"  ✓ Switched to {name}")
            if active == "claude-jr":
                print("  Applied to live config — reload VS Code.\n")
            else:
                print("  Saved to profile — takes effect on next claude-jr.\n")
        else:
            print("  Invalid choice.\n")
    except ValueError:
        print("  Invalid choice.\n")

if __name__ == "__main__":
    main()
