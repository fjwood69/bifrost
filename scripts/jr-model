#!/usr/bin/env python3
"""Switch the active custom model for the claude-jr Bifrost backend."""

import json
import sys
import os
import tty
import termios

PROFILE      = os.path.expanduser("~/.claude-profiles/claude-jr/settings.json")
ACTIVE       = os.path.expanduser("~/.claude-profiles/.active")
BIFROST_DB        = "/data/bifrost/config.db"
BIFROST_VK        = "claude-jr"
BIFROST_VK_PASSTHROUGH = "claude-jr-passthrough"

MODELS = [
    # DeepSeek V3.2
    ("deepseek",      "nebius/deepseek-ai/DeepSeek-V3.2",               "DeepSeek V3.2",                    "66% Nebius / 34% Parasail / Vertex fallback via routing rule"),
    # DeepSeek V4 Flash (new)
    ("deepseek-v4-flash", "Deepinfra/deepseek-ai/DeepSeek-V4-Flash",    "DeepSeek V4 Flash (DeepInfra)",    "DeepSeek V4 Flash via Bifrost → DeepInfra"),
    # Gemini
    ("gemini",        "gemini/gemini-3-flash-preview",                  "Gemini 3 Flash (Google)",          "1M ctx via Bifrost → Google"),
    # Gemma
    ("gemma26b",      "parasail/google/gemma-4-26B-A4B-it",             "Gemma 4 26B A4B (Parasail)",       "Google MoE via Bifrost → Parasail"),
    ("gemma26b-v",    "vertex/google/gemma-4-26b-a4b-it-maas",          "Gemma 4 26B A4B (Vertex MaaS)",    "Google MoE via Bifrost → Vertex AI"),
    # GLM
    ("glm5",          "vertex/zai-org/glm-5-maas",                      "GLM-5 (Vertex MaaS)",              "Zhipu GLM-5 via Bifrost → Vertex AI"),
    # Kimi
    ("kimi",          "Deepinfra/moonshotai/Kimi-K2.6",                 "Kimi K2.6",                        "80% DeepInfra / 20% Parasail via routing rule"),
    # MiniMax
    ("minimax",       "nebius/MiniMaxAI/MiniMax-M2.5",                  "MiniMax M2.5 (Nebius)",            "MiniMax via Bifrost → Nebius"),
    # Qwen
    ("qwen3-next",    "nebius/Qwen/Qwen3-Next-80B-A3B-Thinking",        "Qwen3-Next-80B Thinking (Nebius)", "Thinking MoE via Bifrost → Nebius"),
    ("qwen35",        "parasail/Qwen/Qwen3.5-35B-A3B-FP8",              "Qwen3.5-35B FP8 (Parasail)",       "Fast MoE via Bifrost → Parasail"),
]

# ── Bifrost VK helpers ────────────────────────────────────────────────────────

def update_bifrost_vk_override(compound_model: str) -> bool:
    """Write model_override to both Bifrost governance VKs and restart the container."""
    import sqlite3, subprocess
    try:
        desc = json.dumps({"model_override": compound_model})
        conn = sqlite3.connect(BIFROST_DB)
        conn.execute(
            "UPDATE governance_virtual_keys SET description = ? WHERE name = ?",
            [desc, BIFROST_VK],
        )
        conn.execute(
            "UPDATE governance_virtual_keys SET description = ? WHERE name = ?",
            [desc, BIFROST_VK_PASSTHROUGH],
        )
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"  Warning: could not update Bifrost DB: {e}")
        return False
    try:
        subprocess.run(["podman", "restart", "bifrost"],
                       check=True, capture_output=True, timeout=30)
    except Exception as e:
        print(f"  Warning: could not restart Bifrost container: {e}")
        return False
    return True

# ── Terminal helpers ───────────────────────────────────────────────────────────

def getch():
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

def hr(char="─", width=56):
    print(f"  {char * width}")

# ── VS Code profile ────────────────────────────────────────────────────────────

def find_vscode_profile():
    cfg = os.path.expanduser("~/.claude-profiles/.vscode-profile-path")
    if os.path.exists(cfg):
        return open(cfg).read().strip()
    base = os.path.expanduser("~/.config/Code/User/profiles")
    if not os.path.isdir(base):
        return None
    for name in os.listdir(base):
        candidate = os.path.join(base, name, "settings.json")
        if os.path.exists(candidate):
            try:
                if "claudeCode" in open(candidate).read():
                    return candidate
            except OSError:
                pass
    return None

VSCODE_PROFILE = find_vscode_profile()

def update_vscode_profile(env: dict):
    if not VSCODE_PROFILE:
        return
    try:
        vs = json.load(open(VSCODE_PROFILE))
        vs["claudeCode.environmentVariables"] = [{"name": k, "value": v} for k, v in env.items()]
        json.dump(vs, open(VSCODE_PROFILE, "w"), indent=4)
    except Exception as e:
        print(f"  Warning: could not update VS Code profile: {e}")

# ── Apply ──────────────────────────────────────────────────────────────────────

def apply(model_id, display_name, desc, settings):
    settings.setdefault("env", {})
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION"]             = model_id
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION_NAME"]        = display_name
    settings["env"]["ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION"] = desc
    settings["model"]                                             = model_id
    settings["availableModels"] = [mid for _, mid, _, _ in MODELS]

    with open(PROFILE, "w") as f:
        json.dump(settings, f, indent=2)

    active = open(ACTIVE).read().strip() if os.path.exists(ACTIVE) else ""
    if active == "claude-jr":
        live = os.path.expanduser("~/.claude/settings.json")
        with open(live, "w") as f:
            json.dump(settings, f, indent=2)
        update_vscode_profile(settings["env"])

# ── Current model description ──────────────────────────────────────────────────

def describe_current(model_id):
    if "||" in model_id:
        plan_id = act_id = ""
        for part in model_id.split("||"):
            kv = part.strip().split(":", 1)
            if len(kv) == 2:
                if kv[0].strip() == "plan": plan_id = kv[1].strip()
                elif kv[0].strip() == "act":  act_id  = kv[1].strip()
        plan_name = next((n for _, mid, n, _ in MODELS if mid == plan_id), plan_id or "?")
        act_name  = next((n for _, mid, n, _ in MODELS if mid == act_id),  act_id  or "?")
        return f"Plan: {plan_name}  /  Act: {act_name}", True
    name = next((n for _, mid, n, _ in MODELS if mid == model_id), model_id)
    return name, False

# ── Model picker ───────────────────────────────────────────────────────────────

def pick_model(step_label, subtitle, exclude_id=None):
    """Show a numbered model list and return (model_id, name, desc) or None to go back."""
    candidates = [(mid, name, desc) for _, mid, name, desc in MODELS if mid != exclude_id]

    print(f"\n  ── {step_label} {'─' * max(0, 50 - len(step_label))}")
    print(f"  {subtitle}\n")
    for i, (_, name, desc) in enumerate(candidates, 1):
        print(f"  {i:>2}  {name}")
        print(f"      {desc}")
    print(f"\n   0  Back / Cancel\n")
    print("  Select: ", end="", flush=True)

    try:
        ch = input().strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return None

    if ch in ("0", "q", ""):
        return None
    try:
        idx = int(ch) - 1
        if 0 <= idx < len(candidates):
            return candidates[idx]
    except ValueError:
        pass
    print("  Invalid choice.")
    return None

# ── Single model flow ──────────────────────────────────────────────────────────

def single_flow(settings, current_id):
    candidates = [(mid, name, desc) for _, mid, name, desc in MODELS if mid != current_id]

    print(f"\n  ── Choose model {'─' * 40}")
    for i, (_, name, desc) in enumerate(candidates, 1):
        print(f"  {i:>2}  {name}")
        print(f"      {desc}")
    print(f"\n   0  Cancel\n")
    print("  Select: ", end="", flush=True)

    try:
        ch = input().strip()
    except (EOFError, KeyboardInterrupt):
        print("\n  No change.\n")
        return

    if ch in ("0", "q", ""):
        print("  No change.\n")
        return
    try:
        idx = int(ch) - 1
        if 0 <= idx < len(candidates):
            model_id, name, desc = candidates[idx]
            apply(model_id, name, desc, settings)
            active = open(ACTIVE).read().strip() if os.path.exists(ACTIVE) else ""
            print(f"\n  ✓ Switched to {name}")
            if active == "claude-jr":
                print("  Applied to live config — reload VS Code.\n")
            else:
                print("  Saved to profile — takes effect on next claude-jr.\n")
        else:
            print("  Invalid choice.\n")
    except ValueError:
        print("  Invalid choice.\n")

# ── Plan/Act flow ──────────────────────────────────────────────────────────────

def plan_act_flow(settings):
    while True:
        # Step 1: Plan model
        result = pick_model(
            "Step 1 of 2 — Plan model",
            "Used for planning turns (last message has no tool results)"
        )
        if result is None:
            print("  No change.\n")
            return

        plan_id, plan_name, _ = result

        while True:
            # Step 2: Act model
            result = pick_model(
                "Step 2 of 2 — Act model",
                "Used for execution turns (last message has tool results)",
                exclude_id=None  # allow same model for plan and act
            )
            if result is None:
                break  # back to Step 1

            act_id, act_name, _ = result

            # Step 3: Confirm
            print(f"\n  ── Confirm {'─' * 46}")
            print(f"  Plan:  {plan_name}")
            print(f"  Act:   {act_name}")
            print(f"\n  c  Confirm  |  r  Re-pick from Step 1  |  q  Cancel\n")
            print("  Select [c/r/q]: ", end="", flush=True)

            try:
                ch = getch()
                print(ch)
            except (EOFError, KeyboardInterrupt):
                print("\n  No change.\n")
                return

            if ch in ("c", "\r", "\n", " "):
                compound      = f"plan:{plan_id}||act:{act_id}"
                display_name  = f"Plan: {plan_name} / Act: {act_name}"
                desc          = f"Plan → {plan_name}; Act → {act_name}"
                apply(compound, display_name, desc, settings)
                active = open(ACTIVE).read().strip() if os.path.exists(ACTIVE) else ""
                print(f"\n  ✓ Set Plan: {plan_name}")
                print(f"         Act:  {act_name}")
                if active == "claude-jr":
                    print("  Applied to live config — reload VS Code.\n")
                else:
                    print("  Saved to profile — takes effect on next claude-jr.\n")
                print("  Updating Bifrost VK and restarting container...", end="", flush=True)
                if update_bifrost_vk_override(compound):
                    print(" done.\n")
                else:
                    print("\n  ⚠ Manual steps needed: update Bifrost VK description and restart container.\n")
                return

            elif ch in ("r",):
                break  # break inner loop → back to Step 1

            elif ch in ("q", "\x03", "\x1b", "0"):
                print("  No change.\n")
                return

            else:
                print("  Invalid — press c, r, or q.")
                continue

        # inner loop exited with break → re-run Step 1
        if result is not None:
            # came from 'r' at confirm — restart
            continue
        # came from '0' at Step 2 — restart Step 1
        continue

# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    with open(PROFILE) as f:
        settings = json.load(f)

    current_id   = settings.get("env", {}).get("ANTHROPIC_CUSTOM_MODEL_OPTION", "")
    current_desc, is_plan_act = describe_current(current_id)

    print(f"\n  claude-jr model")
    hr()
    print(f"  Current: {current_desc}")
    hr()
    print()
    print("   1  Single model   — one model for all turns")
    print("   2  Plan / Act     — separate models for planning and execution")
    print()
    print("   0  Exit unchanged")
    print()
    print("  Select [0-2]: ", end="", flush=True)

    ch = getch()
    print(ch)

    if ch in ("0", "q", "\x03", "\x1b", ""):
        print("  No change.\n")
    elif ch == "1":
        single_flow(settings, current_id)
    elif ch == "2":
        plan_act_flow(settings)
    else:
        print("  Invalid choice.\n")

if __name__ == "__main__":
    main()
